+def iequals(*iterables):
+    """Return ``True`` if all given *iterables* are equal to each other,
+    which means they yield the same elements in the same order and have
+    the same length.
+
+        >>> iequals('abc', iter('abc'), ['a', 'b', 'c'])
+        True
+        >>> iequals('abc', 'acb')
+        False
+        >>> iequals(range(3), [0, 1, 2])
+        True
+        >>> iequals([1, 2], [1, 2, None])
+        False
+
+    With zero or one iterable, everything is trivially equal:
+
+        >>> iequals()
+        True
+        >>> iequals('abc')
+        True
+
+    Differing lengths are reported as unequal, so ``None`` can't be used to
+    pad out a short iterable, and no fill value can be mistaken for a real
+    element:
+
+        >>> iequals([], [None])
+        False
+        >>> iequals([], [1, 2])
+        False
+
+    The iterables are consumed lazily, stopping at the first difference:
+
+        >>> from itertools import count
+        >>> iequals(count(), 'abc')  # 0 is not equal to 'a'
+        False
+
+    """
+    if len(iterables) < 2:
+        return True
+
+    # A private sentinel: no item from an iterable can be this object.
+    sentinel = object()
+
+    for group in zip_longest(*iterables, fillvalue=sentinel):
+        if any(x is sentinel for x in group):
+            return False  # the iterables do not have the same length
+        if not all_equal(group):
+            return False
+
+    return True
+
