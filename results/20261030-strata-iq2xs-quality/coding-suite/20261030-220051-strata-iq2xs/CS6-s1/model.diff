+def format_key_part(part: str) -> str:
+    """Render a single key part as it would be written in TOML source."""
+    if BARE_KEY_CHARS.issuperset(part):
+        return part
+    escaped = part.replace("\\", "\\\\").replace('"', '\\"')
+    return f'"{escaped}"'
+
+
+def format_key(key: Key) -> str:
+    """Render a key path as it would be written in TOML source."""
+    return ".".join(format_key_part(part) for part in key)
+
