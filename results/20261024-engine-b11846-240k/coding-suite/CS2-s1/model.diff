+def iequals(*iterables):
+    """Return ``True`` if the given *iterables* yield equal items in the
+    same order and for the same number of times, and ``False`` otherwise.
+
+    >>> iequals([1, 2], (1, 2), iter((1, 2)))
+    True
+    >>> iequals('abc', iter('abc'))
+    True
+    >>> iequals([1, 2], [1, 3])
+    False
+    >>> iequals([1, 2], [1, 2, 3])
+    False
+
+    With zero or one iterable, the result is ``True``:
+
+    >>> iequals()
+    True
+    >>> iequals([1, 2])
+    True
+
+    """
+    if len(iterables) <= 1:
+        return True
+
+    iters = [iter(i) for i in iterables]
+    while True:
+        try:
+            a = next(iters[0])
+        except StopIteration:
+            # The first iterable is exhausted, so the rest must be too
+            return all(not list(it) for it in iters[1:])
+        for it in iters[1:]:
+            try:
+                if next(it) != a:
+                    return False
+            except StopIteration:
+                return False
+
