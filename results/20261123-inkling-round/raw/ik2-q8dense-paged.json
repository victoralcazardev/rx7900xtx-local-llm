{
  "backend": "hip",
  "exe": "build-ik2/maya-ik2",
  "args": [
    "--model",
    "~/IA/Modelos/Inkling-2-Mini-Uncensored-Abiray-q8dense/Inkling-2-Mini-Uncensored-IQ4_NL-q8dense.gguf",
    "--max-context",
    "262144",
    "--chunk",
    "2048"
  ],
  "env": {
    "IK2_HOST": "mmap",
    "IK2_KV": "fp8",
    "IK2_GATE_TILE": "256",
    "IK2_GATE_BF16": "1",
    "IK2_Q8_UNROLL": "1",
    "IK2_BATCH_PREFILL": "1",
    "IK2_PREFILL_WMMA": "1",
    "IK2_PREFILL_TILE": "auto",
    "IK2_PREFILL_SWIGLU": "1",
    "IK2_EXPERT_TILE_LDS": "1",
    "IK2_PREFILL_DENSE": "2",
    "IK2_FLASH": "1",
    "IK2_FLASH_WAVES": "4",
    "IK2_DENSE_WMMA": "1",
    "IK2_DECODE_SUBWAVE": "1",
    "IK2_ATTN_MMA": "3",
    "IK2_GRAPH_PAIR": "1",
    "IK2_ATTN_STAGED": "1",
    "IK2_SHARED_COMBINE": "1",
    "IK2_RESIDENT_ONLY": "1",
    "IK2_EXPERT_LIMB": "0",
    "IK2_F16_MV": "2",
    "IK2_IQ4_MV": "1",
    "IK2_Q8_MV": "1",
    "IK2_DECODE_PROJ": "1",
    "IK2_Q8_TILE": "1",
    "ROCBLAS_TENSILE_LIBPATH": "/opt/rocm/lib/rocblas/library",
    "IK2_PAGED_KV": "1"
  },
  "tokenizer": "ik2/tokenizer",
  "model_name": "inkling-2-mini",
  "sampling": {
    "temperature": 1.0,
    "min_p": 0.0
  },
  "cwd": "~/IA/Motores/src/maya-inkling-mini-hip"
}