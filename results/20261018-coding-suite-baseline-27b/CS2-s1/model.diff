+def iequals(*iterables):
+    """Return ``True`` if all *iterables* yield equal elements in the same
+    order and have the same length, and ``False`` otherwise.
+
+    >>> iequals('abc', 'abc', iter('abc'))
+    True
+    >>> iequals('abc', 'abd')
+    False
+    >>> iequals('abc', 'ab')
+    False
+    >>> iequals()
+    True
+    >>> iequals('abc')
+    True
+
+    With zero or one iterable, ``True`` is returned immediately.
+
+    """
+    if len(iterables) <= 1:
+        return True
+
+    # Zip with a fill value that no element can possibly equal, so that
+    # differing lengths are detected even when an iterable yields ``None``
+    # or items that compare equal to anything (e.g. ``mock.ANY``).
+    for row in zip_longest(*iterables, fillvalue=_marker):
+        for i in range(1, len(row)):
+            if row[i - 1] is _marker or row[i] is _marker or row[i - 1] != row[i]:
+                return False
+
+    return True
+
+
 class AbortThread(BaseException):
     pass
 
