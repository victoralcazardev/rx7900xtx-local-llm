+def iequals(*iterables):
+    """Return ``True`` if the given iterables yield equal elements in the
+    same order and have the same length, otherwise ``False``.
+
+    With zero or one iterables, return ``True``.
+
+        >>> iequals(iter('abc'), iter('abc'))
+        True
+        >>> iequals(iter('abc'), iter('abd'))
+        False
+        >>> iequals(iter('abc'), iter('abcd'))
+        False
+        >>> iequals(iter('abc'))
+        True
+        >>> iequals()
+        True
+
+    """
+    sentinel = object()
+    for row in zip_longest(*iterables, fillvalue=sentinel):
+        # Check identity so the sentinel can never be faked by a real
+        # element (even one that compares equal to everything, such as
+        # mock.ANY).
+        if any(item is sentinel for item in row):
+            return False
+        first, *rest = row
+        if not all(first == item for item in rest):
+            return False
+    return True
+
