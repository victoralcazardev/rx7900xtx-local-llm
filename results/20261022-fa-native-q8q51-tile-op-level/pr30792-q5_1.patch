+// Native-quantized K/V in the tile kernel only pays off for few query columns (decode, MTP verify): from
+// larger batches the f16 scratch conversion is amortized, and reading V raw regresses prefill (reported on
+// PR #30792 for 256-head gemma4). Must be identical in the kernel selector, get_alloc_size() and the tile case.
+#define GGML_CUDA_FATTN_TILE_NATIVE_MAX_NE1 8
+
+// q8_0 K/V can be read raw by the tile kernel when the layouts are block aligned: K requires DKQ % 64 == 0
+// (nbatch_K is a multiple of 64) and V requires DV % QK8_0 == 0. Must match the f16 scratch decision in
+// ggml_cuda_flash_attn_ext_get_alloc_size().
+static inline bool ggml_cuda_fattn_kv_native_q8_0(const ggml_tensor * Q, const ggml_tensor * K, const ggml_tensor * V) {
+    return Q->ne[1] <= GGML_CUDA_FATTN_TILE_NATIVE_MAX_NE1 && K->type == GGML_TYPE_Q8_0 && V->type == GGML_TYPE_Q8_0 &&
+           K->ne[0] % 64 == 0 && V->ne[0] % QK8_0 == 0;
+}
+
+// Asymmetric K/V (f16 K with q8_0 V); also true for the both-q8_0 case, which is checked first.
+static inline bool ggml_cuda_fattn_kv_native_v_q8_0(const ggml_tensor * Q, const ggml_tensor * K, const ggml_tensor * V) {
+    return Q->ne[1] <= GGML_CUDA_FATTN_TILE_NATIVE_MAX_NE1 && V->type == GGML_TYPE_Q8_0 && V->ne[0] % QK8_0 == 0 &&
+           (K->type == GGML_TYPE_F16 || ggml_cuda_fattn_kv_native_q8_0(Q, K, V));
+}
+
+// K q8_0 + V q5_1 (the kvmix profile). K and V are both read raw, V is dequantized in-kernel.
+static inline bool ggml_cuda_fattn_kv_native_q8_0_q5_1(const ggml_tensor * Q, const ggml_tensor * K, const ggml_tensor * V) {
+    return Q->ne[1] <= GGML_CUDA_FATTN_TILE_NATIVE_MAX_NE1 && K->type == GGML_TYPE_Q8_0 && V->type == GGML_TYPE_Q5_1 &&
+           K->ne[0] % 64 == 0 && V->ne[0] % QK5_1 == 0;
+}
+
+// Quantized loader: dequantize q8_0 / q5_1 blocks (32 values) to half2 in registers during the global->shared
+// copy, so the shared KV_tmp layout matches the f16 path and all downstream math is unchanged. KV points to the
+// first element of the first tile row (row/col offsets already applied by the caller); tile_KV rows have stride
+// (J/2 + J_padding) half2.
+template<ggml_type type, int warp_size, int nwarps, int I, int J, int J_padding, bool oob_check>
+static __device__ __forceinline__ void flash_attn_tile_load_tile_quant(
+        const char * const __restrict__ KV, half2 * const __restrict__ tile_KV,
+        const int64_t stride_KV, const int i_sup) {
+    static_assert(type == GGML_TYPE_Q8_0 || type == GGML_TYPE_Q5_1, "bad quantized type");
+    static_assert(QK5_1 == QK8_0, "q5_1 and q8_0 blocks must hold the same number of values");
+    static_assert(J % QK8_0 == 0, "bad J for quantized tile");
+
+    constexpr int blocks_j = J / QK8_0;        // quantized blocks per tile row
+    constexpr int row_h2   = J/2 + J_padding;  // shared row stride in half2
+    const int nthreads = nwarps*warp_size;
+
+    for (int g = threadIdx.y*warp_size + threadIdx.x; g < I*blocks_j; g += nthreads) {
+        const int i = g / blocks_j;
+        const int b = g % blocks_j;
+        half2 * dst = tile_KV + i*row_h2 + b*(QK8_0/2);
+
+#ifdef FP16_AVAILABLE
+        if (oob_check && i >= i_sup) {
+#pragma unroll
+            for (int l = 0; l < QK8_0/2; ++l) {
+                dst[l] = make_half2(0.0f, 0.0f);
+            }
+        } else if constexpr (type == GGML_TYPE_Q8_0) {
+            const block_q8_0 * blk = (const block_q8_0 *) (KV + i*stride_KV) + b;
+            const half2 d = __half2half2(blk->d);
+#pragma unroll
+            for (int l = 0; l < QK8_0; l += 2) {
+                dst[l/2] = d * make_half2(blk->qs[l + 0], blk->qs[l + 1]);
+            }
+        } else {
+            const block_q5_1 * blk = (const block_q5_1 *) (KV + i*stride_KV) + b;
+            const half2 d = __half2half2(__low2half (blk->dm));
+            const half2 m = __half2half2(__high2half(blk->dm));
+            uint32_t qh;
+            ggml_cuda_memcpy_1<sizeof(qh)>(&qh, blk->qh);
+            // value l (< 16) is the low nibble of qs[l], value l + 16 the high nibble of qs[l]; bit l / l + 16 of qh is bit 4
+#pragma unroll
+            for (int l = 0; l < QK5_1/2; l += 2) {
+                const int lo0 = (blk->qs[l + 0] & 0x0F) | (((qh >>  (l + 0))       & 1) << 4);
+                const int lo1 = (blk->qs[l + 1] & 0x0F) | (((qh >>  (l + 1))       & 1) << 4);
+                const int hi0 = (blk->qs[l + 0] >>   4) | (((qh >> (l + 0 + 16))   & 1) << 4);
+                const int hi1 = (blk->qs[l + 1] >>   4) | (((qh >> (l + 1 + 16))   & 1) << 4);
+                dst[l/2]             = d * make_half2(lo0, lo1) + m;
+                dst[l/2 + QK5_1/4]   = d * make_half2(hi0, hi1) + m;
+            }
+        }
+#else
+        (void) i_sup; NO_DEVICE_CODE;
+#endif // FP16_AVAILABLE
+    }
+}
